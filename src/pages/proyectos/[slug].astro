---
import Layout from '../../layouts/Layout.astro';
import FinalCta from '../../components/FinalCta.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, getRelatedProjects, WHATSAPP, type Project, type ProjectImage } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const related = getRelatedProjects(project.slug, 2);

const accentMap: Record<Project['accent'], { bg: string; ink: string; chipBg: string; chipInk: string; soft: string }> = {
  sol: {
    bg: 'linear-gradient(135deg, #FFE8A8 0%, #F7C132 100%)',
    ink: '#1C1C1E',
    chipBg: 'rgba(247, 193, 50, 0.18)',
    chipInk: '#8a6a14',
    soft: 'rgba(247, 193, 50, 0.08)',
  },
  guayaba: {
    bg: 'linear-gradient(135deg, #FFB4B7 0%, #FF5459 100%)',
    ink: '#FFF9F0',
    chipBg: 'rgba(255, 84, 89, 0.12)',
    chipInk: '#b32f34',
    soft: 'rgba(255, 84, 89, 0.07)',
  },
  aqua: {
    bg: 'linear-gradient(135deg, #8FE6D2 0%, #00B896 100%)',
    ink: '#0a2f27',
    chipBg: 'rgba(0, 184, 150, 0.12)',
    chipInk: '#0a7660',
    soft: 'rgba(0, 184, 150, 0.07)',
  },
  carbon: {
    bg: 'linear-gradient(135deg, #4a4a4d 0%, #1C1C1E 100%)',
    ink: '#FFF9F0',
    chipBg: 'rgba(28, 28, 30, 0.08)',
    chipInk: '#1C1C1E',
    soft: 'rgba(28, 28, 30, 0.05)',
  },
};

const accent = accentMap[project.accent];
const initial = project.title.replace(/[^A-Za-zÁÉÍÓÚÑáéíóúñ0-9]/g, '').charAt(0).toUpperCase() || '·';
const heroImage = project.hero ?? project.gallery[0];

const galleryItems = project.gallery.map((img, i, arr) => ({
  img,
  full: arr.length % 2 === 1 && i === arr.length - 1,
}));

const variantLabel: Record<NonNullable<ProjectImage['variant']>, string> = {
  screen: 'Pantalla',
  detail: 'Detalle',
  mobile: 'Móvil',
  brand: 'Marca',
};

const meta = [
  { label: 'Cliente', value: project.client },
  { label: 'Tipo', value: project.clientType },
  { label: 'Servicio', value: project.service },
  { label: 'Año', value: project.year },
];
---

<Layout
  title={`${project.title} — Proyecto | HeyJimmi`}
  description={project.summary}
>
  <article class="project-detail">
    <section class="detail-hero">
      <div class="detail-hero-inner">
        <a href="/proyectos" class="back-link">
          <span aria-hidden="true">←</span> Volver a proyectos
        </a>
        <p class="section-eyebrow detail-category">{project.category}</p>
        <h1 class="detail-title">{project.title}</h1>
        <p class="detail-summary">{project.summary}</p>

        <div class="detail-tags">
          {project.tags.map((tag) => (
            <span class="detail-tag" style={`background: ${accent.chipBg}; color: ${accent.chipInk};`}>
              {tag}
            </span>
          ))}
        </div>

        <dl class="detail-meta">
          {meta.map((item) => (
            <div class="detail-meta-item">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>

        <div class="detail-hero-ctas">
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener" class="btn-primary detail-cta detail-cta--primary">
              Ver proyecto en vivo ↗
            </a>
          )}
          <a href={WHATSAPP} class="btn-secondary detail-cta detail-cta--secondary" target="_blank" rel="noopener">
            Quiero algo así
          </a>
        </div>
      </div>
    </section>

    <section class="detail-hero-image">
      <figure class="hero-figure" style={`background: ${accent.bg}; color: ${accent.ink};`}>
        {heroImage?.src ? (
          <img src={heroImage.src} alt={heroImage.alt} />
        ) : (
          <>
            <span class="hero-figure-mark">{initial}</span>
            <span class="hero-figure-label">{project.client}</span>
            <span class="hero-figure-watermark" aria-hidden="true">{project.title}</span>
          </>
        )}
      </figure>
    </section>

    <section class="detail-section detail-intro" style={`background: ${accent.soft};`}>
      <div class="detail-section-inner intro-grid">
        <div>
          <p class="section-eyebrow">El reto</p>
          <p class="intro-text">{project.challenge}</p>
        </div>
        <div>
          <p class="section-eyebrow">Cómo lo resolvimos</p>
          <p class="intro-text">{project.approach}</p>
        </div>
      </div>
    </section>

    <section class="detail-section">
      <div class="detail-section-inner detail-section-inner--narrow">
        <p class="section-eyebrow">Sobre el proyecto</p>
        <h2 class="detail-h2">Lo que construimos para {project.client}.</h2>
        <p class="long-description">{project.longDescription}</p>
      </div>
    </section>

    {project.gallery.length > 0 && (
      <section class="detail-section detail-section--tight">
        <div class="detail-section-inner">
          <div class="detail-section-header">
            <p class="section-eyebrow">Galería</p>
            <h2 class="detail-h2">Pantallas y detalles del producto.</h2>
          </div>
          <div class="gallery">
            {galleryItems.map(({ img, full }) => (
              <figure class:list={['gallery-item', `gallery-item--${img.aspect ?? 'wide'}`, full && 'gallery-item--full']}>
                {img.src ? (
                  <img src={img.src} alt={img.alt} loading="lazy" />
                ) : (
                  <div class="gallery-placeholder" style={`background: ${accent.bg}; color: ${accent.ink};`}>
                    <span class="gallery-mark">{initial}</span>
                    {img.variant && (
                      <span class="gallery-variant">{variantLabel[img.variant]}</span>
                    )}
                  </div>
                )}
                {(img.caption || img.alt) && (
                  <figcaption>{img.caption ?? img.alt}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="detail-section">
      <div class="detail-section-inner">
        <div class="detail-section-header">
          <p class="section-eyebrow">Funciones clave</p>
          <h2 class="detail-h2">Lo que incluye la plataforma.</h2>
        </div>
        <ul class="features">
          {project.features.map((feature) => (
            <li class="feature-item">
              <span class="feature-check" aria-hidden="true">✓</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="detail-section detail-section--split">
      <div class="detail-section-inner split-grid">
        <div class="split-goals">
          <p class="section-eyebrow">Objetivos</p>
          <h2 class="detail-h2 detail-h2--sm">¿Qué buscábamos lograr?</h2>
          <ol class="goals">
            {project.goals.map((goal, i) => (
              <li class="goal-item">
                <span class="goal-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="goal-text">{goal}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="split-results">
          <p class="section-eyebrow">Resultados</p>
          <h2 class="detail-h2 detail-h2--sm">El valor entregado.</h2>
          <div class="results">
            {project.results.map((result) => (
              <div class="result-card">
                <div class="result-value">{result.value}</div>
                <div class="result-label">{result.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {project.liveUrl && (
      <section class="detail-section detail-section--tight">
        <div class="detail-section-inner live-band">
          <div>
            <p class="section-eyebrow">En producción</p>
            <h3 class="live-title">Este proyecto está en vivo hoy.</h3>
            <p class="live-sub">Velo funcionando con clientes reales.</p>
          </div>
          <a href={project.liveUrl} target="_blank" rel="noopener" class="btn-primary live-btn">
            Visitar {project.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗
          </a>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <>
        <hr class="rule" />
        <section class="detail-section">
          <div class="detail-section-inner">
            <div class="detail-section-header">
              <p class="section-eyebrow">Otros proyectos</p>
              <h2 class="detail-h2">Más cosas que hemos construido.</h2>
            </div>
            <div class="related-grid">
              {related.map((p) => (
                <ProjectCard project={p} variant="preview" />
              ))}
            </div>
            <div class="related-footer">
              <a href="/proyectos" class="btn-secondary related-btn">Ver todos los proyectos</a>
            </div>
          </div>
        </section>
      </>
    )}
  </article>

  <FinalCta />
</Layout>

<style>
  .project-detail {
    display: block;
  }

  /* Hero */
  .detail-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 24px 32px;
  }

  .detail-hero-inner {
    max-width: 820px;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-carbon);
    opacity: 0.55;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  .detail-category {
    margin-bottom: 14px;
  }

  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.6vw, 60px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: var(--color-carbon);
    margin: 0 0 20px;
  }

  .detail-summary {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    opacity: 0.78;
    max-width: 680px;
    margin: 0 0 26px;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 32px;
  }

  .detail-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    font-weight: 500;
  }

  .detail-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 32px;
    margin: 0 0 36px;
    padding: 22px 0;
    border-top: 1px solid rgba(28, 28, 30, 0.1);
    border-bottom: 1px solid rgba(28, 28, 30, 0.1);
  }

  .detail-meta-item dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 4px;
  }

  .detail-meta-item dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-carbon);
    line-height: 1.4;
  }

  .detail-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .detail-cta {
    font-size: 14px;
    padding: 12px 22px;
    border-radius: 8px;
  }

  /* Hero image */
  .detail-hero-image {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 72px;
  }

  .hero-figure {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px;
    margin: 0;
  }

  .hero-figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 15%, rgba(255, 249, 240, 0.22) 0%, transparent 45%),
      radial-gradient(circle at 85% 85%, rgba(28, 28, 30, 0.15) 0%, transparent 55%);
    pointer-events: none;
  }

  .hero-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-figure-mark {
    font-family: var(--font-display);
    font-size: clamp(120px, 16vw, 220px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -8px;
    align-self: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero-figure-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
    align-self: flex-end;
    position: relative;
    z-index: 1;
  }

  .hero-figure-watermark {
    position: absolute;
    bottom: 28px;
    left: 40px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 2.4vw, 28px);
    opacity: 0.5;
    z-index: 1;
  }

  /* Generic section */
  .detail-section {
    padding: 72px 0;
  }

  .detail-section--tight {
    padding: 56px 0;
  }

  .detail-section-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .detail-section-inner--narrow {
    max-width: 800px;
  }

  .detail-section-header {
    margin-bottom: 36px;
  }

  .detail-h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.8px;
    max-width: 640px;
    margin: 8px 0 0;
  }

  .detail-h2--sm {
    font-size: clamp(22px, 2.6vw, 28px);
    max-width: 100%;
  }

  /* Intro grid (challenge + approach) */
  .detail-intro {
    padding: 64px 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  .intro-text {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-carbon);
    opacity: 0.82;
    margin: 12px 0 0;
  }

  .long-description {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-carbon);
    opacity: 0.88;
    margin: 20px 0 0;
  }

  /* Gallery */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .gallery-item {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    margin: 0;
    background: rgba(28, 28, 30, 0.04);
    border: 1.5px solid rgba(28, 28, 30, 0.08);
    aspect-ratio: 16 / 10;
  }

  .gallery-item--portrait {
    aspect-ratio: 3 / 4;
  }

  .gallery-item--square {
    aspect-ratio: 1 / 1;
  }

  .gallery-item--full {
    grid-column: 1 / -1;
    aspect-ratio: 21 / 9;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    position: relative;
  }

  .gallery-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 249, 240, 0.18) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(28, 28, 30, 0.14) 0%, transparent 50%);
    pointer-events: none;
  }

  .gallery-mark {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2px;
    align-self: flex-start;
    position: relative;
    z-index: 1;
  }

  .gallery-variant {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
    align-self: flex-end;
    position: relative;
    z-index: 1;
  }

  .gallery-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px 14px;
    background: linear-gradient(0deg, rgba(28, 28, 30, 0.7) 0%, rgba(28, 28, 30, 0) 100%);
    color: var(--color-crema);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .gallery-item:hover figcaption {
    opacity: 1;
  }

  /* Features */
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 32px;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(28, 28, 30, 0.08);
    font-size: 15px;
    line-height: 1.55;
  }

  .feature-check {
    color: var(--color-aqua);
    font-weight: 700;
    flex-shrink: 0;
    font-size: 13px;
    margin-top: 4px;
  }

  /* Split goals + results */
  .detail-section--split {
    background: var(--color-carbon);
    color: var(--color-crema);
  }

  .detail-section--split .section-eyebrow,
  .detail-section--split .detail-h2 {
    color: var(--color-crema);
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  .goals {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .goal-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 249, 240, 0.1);
  }

  .goal-item:last-child {
    border-bottom: none;
  }

  .goal-num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--color-sol);
    flex-shrink: 0;
    min-width: 28px;
    line-height: 1.3;
  }

  .goal-text {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.9;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 24px;
  }

  .result-card {
    border: 1.5px solid rgba(255, 249, 240, 0.14);
    border-radius: 12px;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(255, 249, 240, 0.03);
  }

  .result-value {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 38px);
    font-weight: 700;
    letter-spacing: -1.5px;
    line-height: 1;
    color: var(--color-sol);
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    line-height: 1.45;
  }

  /* Live band */
  .live-band {
    border: 1.5px solid rgba(28, 28, 30, 0.12);
    border-radius: 16px;
    padding: 32px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .live-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.8vw, 28px);
    font-weight: 600;
    letter-spacing: -0.5px;
    margin: 6px 0 4px;
  }

  .live-sub {
    font-size: 14px;
    opacity: 0.68;
    margin: 0;
  }

  .live-btn {
    font-size: 14px;
    padding: 13px 22px;
    border-radius: 8px;
  }

  /* Related */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .related-footer {
    margin-top: 28px;
    display: flex;
    justify-content: center;
  }

  .related-btn {
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 8px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .intro-grid,
    .split-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .features {
      grid-template-columns: 1fr;
    }

    .gallery {
      gap: 14px;
    }

    .gallery-item--full {
      aspect-ratio: 16 / 9;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .live-band {
      padding: 26px 22px;
    }

    .results {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .detail-hero {
      padding: 36px 20px 24px;
    }

    .detail-hero-image {
      padding: 0 20px 56px;
    }

    .hero-figure {
      padding: 24px;
      border-radius: 14px;
    }

    .hero-figure-watermark {
      left: 24px;
      bottom: 18px;
    }

    .detail-section {
      padding: 56px 0;
    }

    .detail-section--tight {
      padding: 44px 0;
    }

    .detail-intro {
      padding: 48px 0;
    }

    .detail-section-inner {
      padding: 0 20px;
    }

    .detail-meta {
      grid-template-columns: 1fr 1fr;
      gap: 16px 24px;
    }

    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery-item--full {
      aspect-ratio: 16 / 9;
    }

    .results {
      grid-template-columns: 1fr;
    }

    .gallery-item figcaption {
      opacity: 1;
    }
  }
</style>
